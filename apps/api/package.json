{
  "name": "@agridealer/api",
  "version": "0.1.0",
  "private": true,
  "description": "AgriDealer ERP backend - Express + TypeScript + MongoDB",
  "license": "UNLICENSED",
  "author": "Raghava9441 <raghavendrareddybollapu556@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raghava9441/Agridealer.git",
    "directory": "apps/api"
  },
  "bugs": {
    "url": "https://github.com/Raghava9441/Agridealer/issues"
  },
  "homepage": "https://github.com/Raghava9441/Agridealer/tree/main/apps/api#readme",
  "keywords": [
    "erp",
    "api",
    "express",
    "mongodb",
    "multi-tenant",
    "rest"
  ],
  "type": "commonjs",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "dotenv -e .env -- ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('coverage',{recursive:true,force:true})\"",
    "seed": "dotenv -e .env -- ts-node --transpile-only src/scripts/seed.ts"
  },
  "dependencies": {
    "@agridealer/contracts": "*",
    "argon2": "^0.41.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "otplib": "^12.0.1",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "rate-limit-redis": "^4.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^7.4.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.1",
    "pino-pretty": "^11.2.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.0"
  }
}
