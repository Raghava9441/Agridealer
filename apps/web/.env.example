# Dev: leave VITE_API_BASE_URL unset — the API base URL is derived from the
# current page's hostname (so it follows *.localhost subdomains) plus this
# port. Prod: set VITE_API_BASE_URL to the fixed API host instead and this
# is ignored.
VITE_API_PORT=8090
VITE_ROOT_DOMAIN=localhost

# Prod-only override — a fixed API origin, e.g. https://api.agridealer.app/api/v1
# VITE_API_BASE_URL=

# Optional — error reporting stays console-only until this is set (src/monitoring/sentry.ts)
# VITE_SENTRY_DSN=
