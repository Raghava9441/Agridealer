{
  "name": "@agridealer/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas, types, and constants consumed by apps/api and apps/web",
  "license": "UNLICENSED",
  "author": "Raghava9441 <raghavendrareddybollapu556@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raghava9441/Agridealer.git",
    "directory": "packages/contracts"
  },
  "bugs": {
    "url": "https://github.com/Raghava9441/Agridealer/issues"
  },
  "homepage": "https://github.com/Raghava9441/Agridealer/tree/main/packages/contracts#readme",
  "keywords": [
    "zod",
    "schemas",
    "contracts",
    "shared-types",
    "erp"
  ],
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json",
    "dev": "tsc -p tsconfig.cjs.json --watch",
    "typecheck": "tsc -p tsconfig.cjs.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
